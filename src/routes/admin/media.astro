export const prerender = false;

import AdminLayout from './layout.astro';
import { Image as ImageIcon } from '@lucide/astro';
import { loadSite } from '../../api/data.js';
import { resolveUiLocale } from './i18n/resolve.js';
import { createT } from './i18n/t.js';
import { readBakedConfig } from '../../utils/baked.js';
import { DEFAULT_ALLOWED_FILE_TYPES, decodeAllowlist } from '../../utils/file-catalog.js';

// Build the dynamic accept attribute for the upload dropzone. Resolved through the shared bake path
// (readBakedConfig + decodeAllowlist), the same decoder the server and the block-form picker use, so
// the readers can no longer drift and a malformed element is rejected rather than cast through
// (#116, ADR-0033). Note `accept` is only a picker hint — the server enforces the allowlist. For an
// empty allowlist this renders `accept=""`, which the browser treats as accept-anything; the server
// still rejects every upload, so it is a cosmetic mismatch, not a hole.
const uploadAccept = readBakedConfig('ASTRO_BLOCKS_ALLOWED_FILE_TYPES', {
  decode: decodeAllowlist,
  fallback: DEFAULT_ALLOWED_FILE_TYPES,
}).join(',');

const site = await loadSite();
const uiLocale = resolveUiLocale({
  cookie: Astro.request.headers.get('cookie'),
  acceptLanguage: Astro.request.headers.get('accept-language'),
});
const t = createT(uiLocale);

---

<AdminLayout site={site} title={t('media.title')}>
  <div class="cms-stack">
    <div class="cms-page-intro">
      <div class="cms-page-intro-copy">
        <span class="cms-page-eyebrow">{t('media.eyebrow')}</span>
        <div class="cms-page-header">
          <h1 class="cms-title">{t('media.title')}</h1>
        </div>
        <p class="cms-page-lead">
          {t('media.lead')}
        </p>
      </div>
    </div>

    <!-- Upload area -->
    <div class="cms-card cms-media-upload-card">
      <div
        class="cms-dropzone"
        id="cms-media-dropzone"
        role="region"
        aria-label={t('media.dropzoneAriaLabel')}
      >
        <ImageIcon size={32} aria-hidden="true" class="cms-dropzone-icon" />
        <p class="cms-dropzone-label">{t('media.dropzoneLabel')}</p>
        <p class="cms-muted cms-dropzone-hint">{t('media.dropzoneHint')}</p>
        <button
          type="button"
          id="cms-media-upload-btn"
          class="cms-btn cms-btn-secondary"
          aria-label={t('media.chooseFileAriaLabel')}
        >
          {t('media.chooseFile')}
        </button>
        <input
          type="file"
          id="cms-media-file-input"
          accept={uploadAccept}
          class="cms-hidden"
          aria-label={t('media.fileInputAriaLabel')}
          multiple
        />
      </div>
      <div id="cms-media-upload-progress" class="cms-hidden cms-media-upload-progress" aria-live="polite"></div>
    </div>

    <!-- Search + pagination controls (client-driven; hidden until JS loads) -->
    <div class="cms-media-toolbar cms-hidden" id="cms-media-toolbar" aria-label={t('media.searchAriaLabel')}>
      <div class="cms-media-toolbar-search">
        <label for="cms-media-search" class="cms-visually-hidden">{t('media.searchLabel')}</label>
        <input
          type="search"
          id="cms-media-search"
          class="cms-input cms-media-search-input"
          placeholder={t('media.searchPlaceholder')}
          autocomplete="off"
          aria-label={t('media.searchAriaLabel')}
        />
      </div>
      <div class="cms-media-toolbar-pagination">
        <button type="button" id="cms-media-prev" class="cms-btn cms-btn-secondary" aria-label={t('media.prevPage')} disabled>{t('media.prevBtn')}</button>
        <span id="cms-media-page-indicator" class="cms-media-page-indicator cms-muted" aria-live="polite" aria-atomic="true"></span>
        <button type="button" id="cms-media-next" class="cms-btn cms-btn-secondary" aria-label={t('media.nextPage')} disabled>{t('media.nextBtn')}</button>
      </div>
      <p role="status" aria-live="polite" id="cms-media-count" class="cms-media-count cms-muted"></p>
    </div>

    <!-- Media grid.
         Deliberately renders NO cards. handleGetMedia is the only implementation of "which media
         entries are listed, in what order" (ADR-0036); client/media.ts fetches page 1 and renders
         it. This is not a perf trade: initMediaPage() replaced the server-rendered grid on every
         load anyway, and the toolbar stayed hidden until it did, so the SSR grid was built,
         shipped and discarded while being unusable in the interim.
         The id is load-bearing — renderGrid() targets it. -->
    <div class="cms-card cms-card--no-padding" id="cms-media-grid-card">
      <p id="cms-media-loading" class="cms-muted cms-media-loading" role="status" aria-live="polite">
        {t('media.loading')}
      </p>
    </div>
  </div>

  <script>
    import { initMediaPage } from './client/media.js';
    initMediaPage();
  </script>
</AdminLayout>
