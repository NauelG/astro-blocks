# Package-root data/ must never exist; it is always consumer/playground-scoped.
# If tests leak writes to process.cwd()/data, git will not track them.
# Anchored to the repo root so it does NOT also ignore the versioned
# playgrounds/basic/data/ demo directory (media.json lives there).
/data/
# public/uploads/

# NOTE: playgrounds/basic/public/uploads/ and playgrounds/basic/data/media.json
# are intentionally VERSIONED — they hold the curated MediaShowcase demo state
# (6 placeholder images + responsive variants + ready registry) so the example
# works on clone with no setup. Do not re-add them here.

# Coverage y tests
coverage/
.coverage-v8/
.nyc_output/

# Cache
.cache/
.turbo/
.npm-cache/
.atl/.skill-registry.cache.json
*.tgz
PLAN.md
# e2e
.coverage-browser/
.e2e-data/

# Playwright
test-results/
playwright-report/

# Agent skills — only the project-curated set is tracked (real content under
# .agents/skills/, mirrored as symlinks in .claude/skills/). Locally-installed
# personal/global skill packs are ignored so they don't leak into the repo.
# Already-tracked skills stay tracked regardless; to add a NEW project skill, force it:
#   git add -f .agents/skills/<name> .claude/skills/<name>
.agents/skills/
.claude/skills/

# Agent persistent memory store (local, not project source).
.engram/
