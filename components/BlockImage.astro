/**
 * BlockImage — renders an image from an ImageFieldValue (or legacy string URL).
 *
 * Props:
 *   image    — ImageFieldValue | string  (string is coerced via toImageValue)
 *   sizes    — string (default '100vw') — forwarded to <source sizes>
 *   priority — boolean (default false) — when true: loading='eager' + fetchpriority='high'
 *   ...rest  — any additional HTML img attributes (class, etc.)
 *
 * Rendering rules (REQ-7, WCAG 1.1.1):
 *   - When getMediaVariants returns status:'ready' AND variants.length > 0:
 *     emits <picture> with <source type="image/avif" ...> + <source type="image/webp" ...>
 *     + fallback <img> with full attrs.
 *   - All other states (processing, failed, none, legacy, SVG):
 *     emits plain <img> (graceful degradation).
 *   - alt is ALWAYS present on the <img>, even when empty (WCAG 1.1.1).
 *   - priority=true → loading='eager' + fetchpriority='high' (NOT lazy).
 *   - priority=false → loading='lazy' + decoding='async'.
 */

import type { ImageFieldValue } from '../types/index.js';
import { toImageValue, imageAttrs, buildSrcset } from '../utils/image-value.js';
import { getMediaVariants } from '../utils/getMediaVariants.js';

interface Props {
  image: ImageFieldValue | string;
  sizes?: string;
  priority?: boolean;
  [key: string]: unknown;
}

const { image, sizes = '100vw', priority = false, ...rest } = Astro.props;

const v = toImageValue(image);
const attrs = imageAttrs(v);

// Lookup responsive image variants from the media registry
const mv = await getMediaVariants(v.url);

// Determine loading attributes based on priority prop
const loadingAttr = priority ? 'eager' : 'lazy';
const decodingAttr = priority ? undefined : 'async';
const fetchpriorityAttr = priority ? 'high' : undefined;
---

{mv.status === 'ready' && mv.variants.length > 0 ? (
  <picture>
    <source
      type="image/avif"
      srcset={buildSrcset(mv.variants, 'avif')}
      sizes={sizes}
    />
    <source
      type="image/webp"
      srcset={buildSrcset(mv.variants, 'webp')}
      sizes={sizes}
    />
    <img
      src={attrs.src}
      alt={attrs.alt}
      width={attrs.width}
      height={attrs.height}
      loading={loadingAttr}
      decoding={decodingAttr}
      fetchpriority={fetchpriorityAttr}
      {...rest}
    />
  </picture>
) : (
  <img
    src={attrs.src}
    alt={attrs.alt}
    width={attrs.width}
    height={attrs.height}
    loading={loadingAttr}
    decoding={decodingAttr}
    fetchpriority={fetchpriorityAttr}
    {...rest}
  />
)}
