{
  "name": "@astroblocks/astro-blocks",
  "version": "3.0.2",
  "description": "Block-based content CMS integration for Astro with admin panel, page builder, menus, SEO and cache invalidation.",
  "homepage": "https://github.com/NauelG/astro-blocks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NauelG/astro-blocks.git"
  },
  "bugs": {
    "url": "https://github.com/NauelG/astro-blocks/issues"
  },
  "license": "BUSL-1.1",
  "type": "module",
  "bin": {
    "astro-blocks": "./dist/plugin/cli/index.js"
  },
  "main": "./dist/plugin/index.js",
  "exports": {
    ".": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.js"
    },
    "./getMenu": {
      "types": "./dist/utils/getMenu.d.ts",
      "import": "./dist/utils/getMenu.js"
    },
    "./getConfig": {
      "types": "./dist/utils/getConfig.d.ts",
      "import": "./dist/utils/getConfig.js"
    },
    "./getLanguages": {
      "types": "./dist/utils/getLanguages.d.ts",
      "import": "./dist/utils/getLanguages.js"
    },
    "./getI18nMeta": {
      "types": "./dist/utils/getI18nMeta.d.ts",
      "import": "./dist/utils/getI18nMeta.js"
    },
    "./components/GlobalBlock": {
      "import": "./dist/components/GlobalBlock.astro"
    },
    "./components/BlockImage": {
      "import": "./dist/components/BlockImage.astro"
    },
    "./getMediaVariants": {
      "types": "./dist/utils/getMediaVariants.d.ts",
      "import": "./dist/utils/getMediaVariants.js"
    }
  },
  "types": "./dist/plugin/index.d.ts",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "features:validate": "node scripts/validate-features.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.js",
    "prepare:playground": "npm run build && node scripts/install-playground-package.mjs",
    "dev:playground": "npm run prepare:playground && npm run dev --workspace astro-blocks-playground",
    "build:playground": "npm run prepare:playground && npm run build --workspace astro-blocks-playground",
    "clean:playground": "rimraf playgrounds/basic/.astro playgrounds/basic/.astro-blocks",
    "dev:playground:fresh": "npm run clean:playground && npm run dev:playground",
    "screenshots:readme": "node scripts/capture-readme-screenshots.mjs",
    "screenshots:media": "node scripts/capture-media-screenshots.mjs",
    "pack:local": "node scripts/pack-local.mjs",
    "preversion": "npm test",
    "version": "node scripts/sync-readme-version.mjs && npm run screenshots:readme && npm run screenshots:media && git add README.md img/",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@lucide/astro": "^1.18.0",
    "@picocss/pico": "^2.1.1",
    "animate.css": "^4.1.1",
    "image-size": "^2.0.2",
    "jose": "^6.2.3",
    "sharp": "^0.35.1",
    "simple-dropzone": "^0.8.3",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "astro": "^6.4.6",
    "playwright": "^1.60.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "astro": "^6.0.0"
  },
  "files": [
    "dist",
    "AGENTS.consumer.md"
  ],
  "keywords": [
    "astro",
    "astro-integration",
    "withastro",
    "cms",
    "headless-cms",
    "content-management",
    "seo",
    "tooling",
    "utils"
  ],
  "workspaces": [
    "playgrounds/*"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
